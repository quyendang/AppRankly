    "Có dữ liệu đến %@": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Data through %@"}}, "vi": {"stringUnit": {"state": "translated", "value": "Có dữ liệu đến %@"}}}},
    "Có store chưa đồng bộ được. Danh sách có thể chỉ gồm review đã lưu.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Some stores could not sync. The list may contain cached reviews only."}}, "vi": {"stringUnit": {"state": "translated", "value": "Có store chưa đồng bộ được. Danh sách có thể chỉ gồm review đã lưu."}}}},
    "Có thể dùng {name}, {rating} và {app} cho từng review.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use {name}, {rating}, and {app} for each review."}}, "vi": {"stringUnit": {"state": "translated", "value": "Có thể dùng {name}, {rating} và {app} cho từng review."}}}},
