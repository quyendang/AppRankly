# Local template only. Copy to .env at the repository root and keep it untracked.
# In Railway, enter values directly in service Variables instead.
# Never prefix any secret with VITE_. Never paste real credentials into this file.

# Local defaults. Railway Docker sets NODE_ENV=production and DATA_DIR=/app/data.
NODE_ENV=development
PORT=3000
DATA_DIR=./app/data
APP_ORIGIN=http://localhost:3000

# REQUIRED: generate with openssl rand -hex 32; no usable default is provided.
JWT_SECRET=
# REQUIRED: generate using node app/cli.js hash-password (stdin; see DEPLOYMENT.md).
# Use single quotes around a bcrypt hash when storing it in a local dotenv file.
ADMIN_PASSWORD_HASH=

# Optional existing SQLite file INSIDE DATA_DIR. Default: DATA_DIR/database.sqlite.
# DB_PATH=/app/data/database.sqlite

# Google Play: set BOTH values or leave both empty.
# GOOGLE_SERVICE_ACCOUNT_JSON contains JSON, not a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_BUCKET_NAME=

# App Store Connect: set ALL FOUR values or leave all empty.
# APPLE_PRIVATE_KEY contains the PEM, not a path; literal \n is supported.
APPLE_PRIVATE_KEY=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_VENDOR_ID=

# Optional AI provider. Calls require preview and explicit confirmation in the UI.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional notification destinations. Notifications remain disabled until enabled
# in Settings. These services receive notification content when enabled.
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
