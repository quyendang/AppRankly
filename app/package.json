{
  "name": "apprankly",
  "version": "2.1.0",
  "description": "Google Play Store app statistics viewer with interactive dashboard and CLI utility",
  "main": "server.js",
  "scripts": {
    "test": "node test/run.js",
    "start": "node server.js",
    "server": "node --watch server.js",
    "cli": "node cli.js",
    "db:migrate": "node cli.js migrate",
    "db:status": "node cli.js status",
    "cache:clear": "node cli.js cache-clear",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "watch:frontend": "cd frontend && npm run build -- --watch",
    "dev": "concurrently \"npm run server\" \"npm run dev:frontend\" \"npm run watch:frontend\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fast-csv/parse": "^4.3.6",
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^2.16.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^11.3.2",
    "google-play-scraper": "^10.1.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "openai": "^6.49.0"
  },
  "overrides": {
    "undici": "^7.29.0",
    "qs": "^6.17.1"
  },
  "keywords": [
    "playstore",
    "statistics",
    "dashboard",
    "cli"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
